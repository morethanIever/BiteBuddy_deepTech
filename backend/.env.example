# Copy to .env and fill in values

# Server
PORT=3001
NODE_ENV=production

# Security — CHANGE THESE in production!
JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars
ADMIN_EMAIL=admin@bitebuddy.app
ADMIN_PASSWORD=replace_with_secure_password

# CORS — set to your Vercel frontend URL
FRONTEND_URL=https://bitebuddy.vercel.app
